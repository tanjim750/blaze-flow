# Copy to deploy/backup/backup.env (chmod 600). Not committed (.gitignore).
# age PUBLIC key; create the pair OFF the server: `age-keygen -o blazeflow-backup.key`
AGE_RECIPIENT=age1replace-with-your-public-key
# rclone remote + path, configured with `rclone config` as the backup user. Use a bucket /
# account separate from the app's media bucket, with credentials that cannot delete media.
RCLONE_REMOTE=offsite:blazeflow-backups/postgres
RETENTION_DAYS=30
LOCAL_RETENTION_DAYS=3
LOCAL_DIR=/var/backups/blazeflow
# Optional: ping URL so a missed or failed backup alerts you (e.g. https://hc-ping.com/<uuid>)
HEALTHCHECK_URL=
