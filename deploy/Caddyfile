# Reverse proxy for docker-compose.prod.yml (--profile caddy).
# APP_DOMAIN comes from the environment (e.g. app.example.com). Caddy obtains a
# Let's Encrypt certificate automatically; with Cloudflare in front use SSL mode
# "Full (strict)" (never "Flexible": that loops on Caddy's HTTP->HTTPS redirect).
# Only the Next.js frontend is exposed; it proxies /api/* to Django.
{
	servers {
		# Trust X-Forwarded-For only from Cloudflare's edge, so the browser IP Cloudflare
		# puts there survives (otherwise Caddy replaces the header with the edge IP and
		# all visitors share one rate-limit bucket). Ranges: https://www.cloudflare.com/ips/
		# (checked 2026-11-02; re-check yearly). With no Cloudflare in front this is harmless:
		# untrusted clients' headers are replaced with their real address.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
}

{$APP_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 1GB
	}
	# Caddy appends the Cloudflare edge address to X-Forwarded-For, after the browser IP
	# (see THROTTLE_TRUSTED_PROXY_COUNT in .env.production.example).
	reverse_proxy frontend:3000
}
