                "type": "text/javascript",
                "exec": [
                  "const stages = pm.response.json();",
                  "const reviewStage = stages.find(stage => stage.slug === 'in-review');",
                  "if (reviewStage) pm.collectionVariables.set(\"workflow_stage_id\", reviewStage.id);"
                ]
              }
            }
