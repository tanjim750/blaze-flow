# =====================================================================================
# Blaze Flow production environment — TEMPLATE ONLY. No real values belong in git.
#   cp .env.production.example .env.production && chmod 600 .env.production
# Read by every service in docker-compose.prod.yml (and by compose itself for ${...}
# substitution when passed with --env-file .env.production).
# Values marked REQUIRED have no safe default. Keep a copy in a password manager.
# =====================================================================================

# --- Compose / images -----------------------------------------------------------------
# Public hostname Caddy serves (only with --profile caddy). REQUIRED with caddy.
APP_DOMAIN=app.example.com
# Where the frontend port is published on the host. Keep 127.0.0.1 unless a proxy on
# another machine needs it; Caddy and cloudflared reach it over the compose network.
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=3000
# Image names (override to pull from a registry such as ghcr.io/<owner>/blazeflow-backend:<tag>).
BACKEND_IMAGE=blazeflow-backend:latest
BACKEND_AI_IMAGE=blazeflow-backend-ai:latest
FRONTEND_IMAGE=blazeflow-frontend:latest
# Container limits (docker compose v2 honours deploy.resources.limits).
WEB_MEMORY_LIMIT=1g
OUTBOX_CPU_LIMIT=2
OUTBOX_MEMORY_LIMIT=2g
AI_QA_CPU_LIMIT=4
AI_QA_MEMORY_LIMIT=3g
FRONTEND_MEMORY_LIMIT=768m

# --- Gunicorn (web) -------------------------------------------------------------------
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_LOG_LEVEL=info

# --- Postgres (used by the db container and by Django) ---------------------------------
POSTGRES_DB=blazeflow
POSTGRES_USER=blazeflow
# REQUIRED. Long random value, e.g. `openssl rand -base64 36`.
POSTGRES_PASSWORD=
# Seconds to keep a DB connection open between requests (0 = close after each request).
DB_CONN_MAX_AGE=60
DB_CONN_HEALTH_CHECKS=true

# --- Django core ----------------------------------------------------------------------
# REQUIRED. 50+ random chars: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
# REQUIRED. Public host(s) plus `web` (the Next proxy and container healthcheck call
# Django as http://web:8000).
DJANGO_ALLOWED_HOSTS=app.example.com,web,localhost
# REQUIRED. Public origin(s) that submit forms / unsafe API calls.
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com
DJANGO_LOG_LEVEL=INFO
# HTTPS is enforced by Cloudflare/Caddy at the edge. Django only sees the internal hop
# from Next, so leave the redirect off (turning it on can cause a redirect loop).
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_TRUST_PROXY_HTTPS=true
# Start low, raise to 31536000 after a stable week.
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false

# --- Client IP for rate limiting -------------------------------------------------------
# Number of proxies that append to X-Forwarded-For in front of Django.
# Caddy -> Next -> Django = 2; Cloudflare Tunnel -> Next -> Django = 1.
THROTTLE_TRUSTED_PROXY_COUNT=2
# Use Cloudflare's CF-Connecting-IP header. ONLY enable when the origin is reachable
# exclusively via Cloudflare (tunnel, or firewall limited to Cloudflare IP ranges);
# otherwise clients can spoof it.
THROTTLE_TRUST_CF_CONNECTING_IP=false
REGISTRATION_THROTTLE_RATE=5/hour
LOGIN_THROTTLE_RATE=20/hour
PASSWORD_RESET_THROTTLE_RATE=5/hour
EMAIL_VERIFICATION_THROTTLE_RATE=5/hour
UPLOAD_LINK_THROTTLE_RATE=240/hour
SUPPORT_TICKET_THROTTLE_RATE=20/hour

# --- Public URLs used in emails ---------------------------------------------------------
# REQUIRED.
APP_BASE_URL=https://app.example.com
PASSWORD_RESET_URL=https://app.example.com/reset-password
EMAIL_VERIFICATION_URL=https://app.example.com/verify-email
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_MINUTES=1440

# --- Email ---------------------------------------------------------------------------
# Resend (recommended): set RESEND_API_KEY and DEFAULT_FROM_EMAIL; everything else defaults
# to Resend's SMTP relay (smtp.resend.com:465, SSL, user "resend"). See docs/deploy.md.
# The sender domain must be verified in Resend (SPF + DKIM DNS records on Cloudflare).
# Until it is, only onboarding@resend.dev works as sender and it only delivers to the
# Resend account owner's own address.
# REQUIRED for real email. Create a "Sending access" key restricted to your domain.
RESEND_API_KEY=
# REQUIRED. Must be on the verified domain, e.g. Blaze Flow <no-reply@mail.example.com>.
DEFAULT_FROM_EMAIL=Blaze Flow <no-reply@example.com>
SUPPORT_FROM_EMAIL=
# Any other SMTP provider instead of Resend: leave RESEND_API_KEY empty and set these.
# With neither RESEND_API_KEY nor EMAIL_HOST set, emails are only printed to the logs.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
# Optional explicit override (always wins), e.g. django.core.mail.backends.console.EmailBackend
EMAIL_BACKEND=
EMAIL_TIMEOUT=20
# Where invitation emails link to (defaults to APP_BASE_URL/invite).
INVITE_ACCEPT_URL=https://app.example.com/invite

# --- Sign-up -----------------------------------------------------------------------------
# open | invite_only. Production default: invite_only. People holding a workspace or
# client-team invite can still create an account; everyone else sees "sign-up is by invitation".
SIGNUP_MODE=invite_only

# --- Google sign-in (optional) ----------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
# Frontend build-time value (same client id). Rebuild the frontend image after changing.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- File storage -----------------------------------------------------------------------
# local = files on the `media` volume (single host only); s3 = Cloudflare R2 / S3.
STORAGE_DRIVER=s3
AWS_STORAGE_BUCKET_NAME=blazeflow-production-assets
AWS_S3_REGION_NAME=auto
AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# REQUIRED with s3. Bucket-scoped R2 API token (Object Read & Write on this bucket only).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ADDRESSING_STYLE=virtual
AWS_QUERYSTRING_EXPIRE=300
# Direct browser-to-R2 uploads (needs s3 + a bucket CORS rule for the app origin).
DIRECT_UPLOADS_ENABLED=false
DIRECT_UPLOAD_SINGLE_PUT_MAX_BYTES=67108864
DIRECT_UPLOAD_PART_SIZE=16777216
DIRECT_UPLOAD_URL_EXPIRE_SECONDS=900
DIRECT_UPLOAD_TTL_SECONDS=86400

# --- Upload limits (Cloudflare Free/Pro rejects proxied bodies > 100 MB unless direct
#     uploads are enabled) -----------------------------------------------------------------
MAX_MEDIA_UPLOAD_BYTES=1073741824
MAX_REVIEW_ATTACHMENT_BYTES=26214400
MAX_TASK_ATTACHMENT_BYTES=26214400
MAX_PROJECT_FILE_BYTES=1073741824

# --- Previews / video proxies -----------------------------------------------------------
PREVIEW_MAX_PIXELS=40000000
PREVIEW_MAX_WIDTH=1280
PREVIEW_MAX_HEIGHT=720
PDF_PREVIEW_COMMAND=pdftoppm
FFMPEG_COMMAND=ffmpeg
FFPROBE_COMMAND=ffprobe
PREVIEW_DECODER_TIMEOUT_SECONDS=30
PREVIEW_DECODER_MAX_INPUT_BYTES=26214400
PREVIEW_DECODER_MAX_OUTPUT_BYTES=20971520
PREVIEW_AUDIO_MAX_SECONDS=600
VIDEO_PROXY_MAX_WIDTH=1280
VIDEO_PROXY_MAX_HEIGHT=720
VIDEO_PROXY_CRF=23
VIDEO_PROXY_MAXRATE=5M
VIDEO_PROXY_PRESET=medium
VIDEO_PROXY_KEYFRAME_SECONDS=1
VIDEO_PROXY_HQ_ENABLED=true
VIDEO_PROXY_HQ_MAX_WIDTH=1920
VIDEO_PROXY_HQ_MAX_HEIGHT=1080
VIDEO_PROXY_HQ_CRF=20
VIDEO_PROXY_HQ_MAXRATE=10M
VIDEO_PROXY_AUDIO_BITRATE=128k
VIDEO_PROXY_MAX_INPUT_BYTES=1073741824
VIDEO_PROXY_MAX_OUTPUT_BYTES=209715200
VIDEO_PROXY_TIMEOUT_SECONDS=600

# --- Outbox / processing / security scanning ---------------------------------------------
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETRY_BASE_SECONDS=60
OUTBOX_RETRY_MAX_SECONDS=3600
# EicarAwareScanner is a test stub. For real scanning start --profile malware and set the
# ClamAV scanner class from app/services/file_processing.py.
FILE_SECURITY_SCANNER=app.services.file_processing.EicarAwareScanner
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30
CLAMAV_MAX_STREAM_BYTES=26214400
OPERATIONS_STALE_MINUTES=15
REVIEW_FILE_RETENTION_DAYS=30
WORKSPACE_DELETION_GRACE_DAYS=30

# --- Plans / billing --------------------------------------------------------------------
PLAN_FREE_MAX_WORKSPACES_OWNED=1
PLAN_FREE_MAX_PROJECTS_PER_WORKSPACE=3
PLAN_FREE_MAX_STORAGE_BYTES=5368709120
PLAN_PRO_MAX_WORKSPACES_OWNED=20
PLAN_PRO_MAX_PROJECTS_PER_WORKSPACE=200
PLAN_PRO_MAX_STORAGE_BYTES=2199023255552
SUBSCRIPTION_PRO_PERIOD_DAYS=30
SUBSCRIPTION_TRIAL_DAYS=14
PLATFORM_PRO_PRICE_MINOR=2900
PLATFORM_CURRENCY=GBP
REVIEW_PAGE_SIZE=50
REVIEW_MAX_PAGE_SIZE=200

# --- AI Visual QA -----------------------------------------------------------------------
AI_VISUAL_QA_ENABLED=false
# The web container records this engine on each run and ai-qa-worker executes it, so it
# must be the same for every service. Only the ai-qa-worker image contains PaddleOCR;
# AI_QA_DEDICATED_WORKER=true keeps the outbox worker from picking up OCR jobs.
AI_QA_ENGINE=paddleocr
AI_QA_DEDICATED_WORKER=true
# Paddle threads per worker. Set explicitly (default = all cores, starving gunicorn/FFmpeg).
AI_QA_CPU_THREADS=3
AI_QA_REQUIRE_CLEAN_SCAN=true
AI_QA_DAILY_RUNS_PER_WORKSPACE=50
AI_QA_MAX_CONCURRENT_PER_WORKSPACE=1

# --- Sentry (optional) ------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_SEND_DEFAULT_PII=false
